{
  "name": "neuromod-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the NEUROMOD website: blog feed, patient FAQ, and editor login",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "test": "node --test \"test/*.test.js\"",
    "editor": "node --env-file=.env scripts/editor.js"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.0"
  }
}
