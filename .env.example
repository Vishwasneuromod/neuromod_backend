# Copy to .env (never commit .env)

# --- Database ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGODB_DB=neuromod

# --- Blog (Hashnode) ---
HASHNODE_HOST=yourname.hashnode.dev

# --- Browser access (CORS): exact origins of the website, comma-separated, no trailing slash ---
CORS_ORIGINS=http://localhost:3000,https://neuromod.in,https://www.neuromod.in

# --- Editor login (username + password) ---
# Create editors with:  npm run editor -- add <username>   (password is prompted, stored hashed in MongoDB)
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
SESSION_HOURS=8

# Set true when running behind a load balancer/proxy so rate limits use the real client IP
TRUST_PROXY=false
PORT=8787
